# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=123456:replace-me
STARKNET_RPC_URL=https://starknet-rpc.publicnode.com
CAIRN_CHAIN=SN_MAIN
# Where state lives; ./data by default. The Docker image (/data) and the systemd unit (/var/lib/cairn) set their own.
# CAIRN_DATA=./data
# Optional, round 2: blocks scanned per pass, and watches per chat
# CAIRN_MAX_BLOCKS=500
# CAIRN_MAX_WATCHES=20
# Optional, round 3: seconds of chain time before a Pragma price is stale (no USD value from it)
# CAIRN_PRICE_MAX_AGE=900
# Optional, round 4. Failover: when set, this comma-separated list replaces STARKNET_RPC_URL (all on one chain).
# STARKNET_RPC_URLS=https://your-provider.example/v0_10/your-key,https://starknet-rpc.publicnode.com
# Your own chat id (send /export to the bot in a private chat to see it): told when every endpoint fails.
# CAIRN_OPERATOR_CHAT=123456789
# /healthz and /metrics; off when unset (the Docker image sets 8080 and binds 0.0.0.0 inside the container).
# CAIRN_HTTP_PORT=8080
# CAIRN_HTTP_HOST=127.0.0.1
# Scan only blocks this deep; a stall is this many seconds of wall clock with no new block; reorg hashes kept.
# CAIRN_CONFIRMATIONS=0
# CAIRN_STALL_SECONDS=120
# CAIRN_REORG_DEPTH=64
# Blocks behind beyond which Cairn skips to the head (with a notice) instead of catching up.
# CAIRN_MAX_GAP=50000
# Phishing domains whose links are deleted, one per line; blocklist/domains.txt by default.
# CAIRN_BLOCKLIST=/etc/cairn/blocklist.txt
