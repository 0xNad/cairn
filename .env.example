# Copy to .env and fill in. Never commit .env. Cairn reads only its environment: load the file with
#   node --env-file=.env cairn.mjs doctor
TELEGRAM_BOT_TOKEN=123456:replace-me
STARKNET_RPC_URL=https://starknet-rpc.publicnode.com
CAIRN_CHAIN=SN_MAIN
CAIRN_DATA=./data

# Optional; the defaults are shown. An empty value counts as unset.
# TELEGRAM_API_ROOT=https://api.telegram.org
# CAIRN_NETWORK_FILE=           (default: networks/<CAIRN_CHAIN>.json next to cairn.mjs)
# CAIRN_EXPLORER_URL=https://voyager.online   (on Sepolia: https://sepolia.voyager.online)
# CAIRN_POLL_MS=10000           (at least 50)
# CAIRN_TG_TIMEOUT=30           (long-poll seconds, 0 to 50)
# CAIRN_RPC_RPS=5               (JSON-RPC calls per second, 1 to 100)
# CAIRN_RPC_TIMEOUT_MS=10000    (at least 100)
# CAIRN_LOG=info                (error, warn, info or debug)
