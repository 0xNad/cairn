# Copy to .env and fill in. Never commit .env.
# Run with: node --env-file=.env cairn.mjs doctor   (then: run)
TELEGRAM_BOT_TOKEN=123456:replace-me
STARKNET_RPC_URL=https://starknet-rpc.publicnode.com
CAIRN_CHAIN=SN_MAIN
CAIRN_DATA=./data

# Optional, with their defaults:
# CAIRN_EXPLORER_URL=https://voyager.online
# CAIRN_NETWORK_FILE=networks/SN_MAIN.json
# CAIRN_RPC_RPS=5
# CAIRN_RPC_TIMEOUT_MS=10000
# CAIRN_POLL_MS=10000
# CAIRN_TG_TIMEOUT=30
# CAIRN_LOG=info
