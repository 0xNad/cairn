# Copy to .env (or /etc/cairn/cairn.env for systemd) and fill in. Never commit it: it holds your bot token.
TELEGRAM_BOT_TOKEN=123456:replace-me
STARKNET_RPC_URL=https://starknet-rpc.publicnode.com
CAIRN_CHAIN=SN_MAIN
CAIRN_DATA=./data
# Optional, round 2: blocks scanned per pass, and watches per chat
# CAIRN_MAX_BLOCKS=500
# CAIRN_MAX_WATCHES=20
# Optional, round 3: seconds of chain time before a Pragma price is stale (no USD value from it)
# CAIRN_PRICE_MAX_AGE=900
# Optional, round 4. Failover endpoints, tried in order, all on CAIRN_CHAIN; when set, it replaces STARKNET_RPC_URL.
# STARKNET_RPC_URLS=https://starknet-rpc.publicnode.com,https://your-provider.example/v0_10/YOUR_KEY
# Your own chat id: told once when every endpoint fails, and once when it recovers.
# CAIRN_OPERATOR_CHAT=123456789
# Seconds of wall clock without a new block before /network subscribers get a stall alert.
# CAIRN_STALL_SECONDS=120
# Blocks whose hashes Cairn keeps to detect reorgs; blocks below the head an alert waits for; how many blocks
# behind Cairn may fall before it skips to the head with one notice (0 never skips).
# CAIRN_REORG_DEPTH=64
# CAIRN_CONFIRMATIONS=0
# CAIRN_MAX_GAP=50000
# /healthz and /metrics, on CAIRN_HTTP_HOST (127.0.0.1 by default). Unset: no listener.
# CAIRN_HTTP_PORT=9464
# CAIRN_HTTP_HOST=127.0.0.1
# Your own link blocklist, one domain per line (replaces blocklist/domains.txt).
# CAIRN_BLOCKLIST=/etc/cairn/domains.txt
