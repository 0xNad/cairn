# Copy to .env, fill in, chmod 600, and load it with set -a; . ./.env; set +a.
TELEGRAM_BOT_TOKEN=123456:replace-me
STARKNET_RPC_URLS=https://primary-rpc.example,https://secondary-rpc.example
CAIRN_CHAIN=SN_MAIN
# The systemd unit overrides this with /var/lib/cairn in ExecStart.
CAIRN_DATA=./data
