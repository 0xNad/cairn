# Copy to .env and fill in. Never commit .env. Cairn does not read this file itself: load it into the
# environment (set -a; . ./.env; set +a) before running node cairn.mjs.
TELEGRAM_BOT_TOKEN=123456:replace-me
STARKNET_RPC_URL=https://starknet-rpc.publicnode.com
CAIRN_CHAIN=SN_MAIN
CAIRN_DATA=./data
# Optional (defaults shown):
# CAIRN_EXPLORER_URL=https://voyager.online
# CAIRN_POLL_MS=10000
# CAIRN_TG_TIMEOUT=30
# CAIRN_RPC_RPS=5
# CAIRN_RPC_TIMEOUT_MS=10000
# CAIRN_LOG=info
